.gemini/
.opencode/
.roo/
.cline*
.kilocode/
.zed/
.mcp.json
mcp.json
skills-lock.json

# AI assistant instruction files
CLAUDE.md
CLAUDE.local.md
AGENTS.md
GEMINI.md
.clauderc

# Generated plans, transcripts and notes from AI sessions
docs/

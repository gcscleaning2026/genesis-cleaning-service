# Copy to .env.local and fill in. Never commit .env.local — .gitignore covers .env*.

# Turso (libSQL). Token: `turso db tokens create genesis-cleaning-service`
TURSO_DATABASE_URL="libsql://genesis-cleaning-service-loading2003.aws-us-east-1.turso.io"
TURSO_AUTH_TOKEN=""

# Salt for hashing submitter IPs before they are stored. Any long random string.
REVIEW_IP_SALT=""

# Review submissions allowed per IP per hour. 0 disables the limit — local testing only,
# never set this in production.
REVIEW_RATE_LIMIT_PER_HOUR="3"

# Resend — created by `vercel integration add resend/resend-email`
RESEND_API_KEY=""
REVIEW_FROM_EMAIL="Genesis Reviews <onboarding@resend.dev>"
# Address that receives the "new review pending" notification.
OWNER_EMAIL="leonardojeziellopez@gmail.com"

# Admin area. Hash: `node scripts/hash-password.mjs "<password>"`
ADMIN_USER=""
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""

# Public site origin, used in notification email links
NEXT_PUBLIC_SITE_URL="https://genesis-cleaning-service.vercel.app"
